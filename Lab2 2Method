public class TwoDimensionalArray {
    public static void main(String[] args) {
        int rows = 3; // Specify the number of rows
        int cols = 4; // Specify the number of columns
        int[][] array = createIncrementalArray(rows, cols);
        printArray(array);
    }

    public static int[][] createIncrementalArray(int rows, int cols) {
        int[][] array = new int[rows][cols];
        int value = 1; // Starting value
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                array[i][j] = value;
                value += 3; // Each element is 3 more than the previous one
            }
        }
        return array;
    }

    public static void printArray(int[][] array) {
        for (int[] row : array) {
            for (int element : row) {
                System.out.print(element + " ");
            }
            System.out.println();
        }
    }
}
